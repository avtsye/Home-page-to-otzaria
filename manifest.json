{
  "schemaVersion": 1,
  "id": "new-tab-home",
  "name": "דף הבית",
  "version": "3.3.0",
  "description": "דף בית מודרני לאוצריא עם חיפוש מתקדם, המשך קריאה, מועדפים, סימניות ותוספים.",
  "author": "אברהם mch",
  "homepage": "https://github.com/avtsye/Home-page-to-otzaria",
  "icon": "otzaria-icon.png",
  "minAppVersion": "0.9.97",
  "sdkVersion": "1.x",
  "entrypoint": "index.html",
  "permissions": [
    "app.info.read",
    "navigation.write",
    "library.books.read",
    "reader.open",
    "search.fulltext.read",
    "history.read",
    "bookmarks.read",
    "plugin.open_other",
    "plugin.storage.read",
    "plugin.storage.write",
    "app.startup_contributions",
    "app.run_on_startup"
  ],
  "contributes": {
    "toolTab": {
      "title": "דף הבית",
      "iconName": "home_24_regular",
      "order": 50,
      "defaultPinned": true
    },
    "startup": {
      "activationEvents": [
        "app.startup"
      ],
      "keepAlive": false
    }
  }
}
